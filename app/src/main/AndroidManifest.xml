<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Budzenie ekranu na czas efektu, gdy telefon leży zgaszony -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Prośba o „bateria bez ograniczeń", żeby Android nie usypiał nasłuchu -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lista aplikacji do wyboru (Android 11+ ukrywa je bez tego) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Krawedzie">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Krawedzie">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dowiaduje się o powiadomieniach i dzwonieniu -->
        <service
            android:name=".NasluchPowiadomien"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Rysuje ramkę. Usługa ułatwień dostępu to jedyna droga, żeby ramka była
             nad paskiem stanu, nawigacją i ekranem blokady. Nie czyta treści ekranu. -->
        <service
            android:name=".UslugaRamki"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usluga_ramki" />
        </service>
    </application>
</manifest>
